# ========== 模型 API ==========

# 方案 A(默认,已配好):智谱 GLM-4.7-Flash
#   免费 / 200K 上下文 / 支持工具调用 / 国内直连
#   取 key:https://bigmodel.cn/  → 注册 → 控制台 → API Keys
#   模型文档:https://docs.bigmodel.cn/cn/guide/models/free/glm-4.7-flash
MODEL_API_KEY=在这里填智谱的key
MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4.7-flash

# --- 想换别的?改上面三行就行,代码不用动 ---
# 智谱其他免费模型:glm-4-flash-250414(128K,支持工具调用)
# DeepSeek:https://api.deepseek.com       + deepseek-chat(便宜,需充值)
# 通义千问:https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# OpenAI:  https://api.openai.com/v1      + gpt-4o-mini(需能访问)

# ========== LangSmith 追踪(可选)==========
# ⚠️ 没填下面的 API Key 时,必须把 LANGSMITH_TRACING 设为 false,否则会报错
# 注册:https://smith.langchain.com/ → GitHub 登录 → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langgraph-lab
LANGSMITH_API_KEY=lsv2_在这里填你的key
